# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Data paths (relative to project root in dev, /app in Docker)
DATA_ROOT=./data

# Memory Cache (LRU)
CACHE_MAX_COLLECTIONS=50
CACHE_MAX_SIZE_MB=500
CACHE_COLLECTION_TTL_HOURS=1
CACHE_ICON_TTL_MINUTES=30

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# CORS
CORS_ORIGIN=*

# Inspirations admin API
# Firebase project whose ID tokens are accepted (must match the web app).
FIREBASE_PROJECT_ID=motvin-prod
# Comma-separated list of accounts allowed to upload and edit the library.
INSPIRATIONS_ADMIN_EMAILS=surendarv638@gmail.com
# Largest screenshot accepted by the upload endpoint, in megabytes.
INSPIRATIONS_MAX_UPLOAD_MB=25
