# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Data paths (relative to project root in dev, /app in Docker)
DATA_ROOT=./data

# Memory Cache (LRU)
CACHE_MAX_COLLECTIONS=50
CACHE_MAX_SIZE_MB=500
CACHE_COLLECTION_TTL_HOURS=1
CACHE_ICON_TTL_MINUTES=30

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# CORS
CORS_ORIGIN=*

# Inspirations admin API
# Firebase project whose ID tokens are accepted (must match the web app).
FIREBASE_PROJECT_ID=motvin-prod
# Comma-separated list of accounts allowed to upload and edit the library.
INSPIRATIONS_ADMIN_EMAILS=surendarv638@gmail.com
# Largest screenshot accepted by the upload endpoint, in megabytes.
INSPIRATIONS_MAX_UPLOAD_MB=25

# MCP server (/api/mcp) — lets AI clients search the library after a Motvin sign-in.
# Long random string that signs every MCP token. Required in production; leave
# unset in development to get a throwaway one per boot.
MCP_TOKEN_SECRET=
# Public origin of this API (the OAuth issuer) and the sign-in page on the web app.
# Defaults: these hosts when NODE_ENV=production, else localhost:3000 / localhost:3001.
MCP_ISSUER_URL=https://api.motvin.com
MCP_CONNECT_URL=https://motvin.com/mcp/connect
MCP_SITE_URL=https://motvin.com
# Where disconnected AI tools are remembered across restarts, so a disconnect
# cuts access at once and stays cut. Defaults to <DATA_ROOT>/.mcp-revocations.json;
# point it at a disk that survives deploys.
MCP_REVOCATION_FILE=
# Connected AI tools (Settings → AI tools) and daily usage counts (admin → MCP usage).
# Default to <DATA_ROOT>/.mcp-connections.json and .mcp-usage.json.
MCP_CONNECTIONS_FILE=
MCP_USAGE_FILE=
# Each person's call count for the day (default <DATA_ROOT>/.mcp-rate-limits.json).
MCP_RATE_LIMIT_FILE=
# Rate limits for MCP (0 turns one off). Defaults when unset: 60 tool calls a
# minute and 2000 a day per person, 60 screen previews a minute per person, and
# 30 requests a minute per address to the sign-in (OAuth) endpoints.
MCP_RATE_CALLS_PER_MINUTE=
MCP_RATE_CALLS_PER_DAY=
MCP_RATE_PREVIEWS_PER_MINUTE=
MCP_RATE_OAUTH_PER_MINUTE=
